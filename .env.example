# Supabase（仅本地脚本使用；GitHub Actions 使用同名 Secrets，无需本地 .env）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # 仅 ingest / prerender 脚本
SUPABASE_ANON_KEY=                # 仅 /api 函数

# 数据源（本机周报工作区，含 CSV 与 brand_colors.json）
NEV_DATA_DIR=e:/workbuddy/space

# 无 VITE_ 前缀变量：前端纯静态，不注入任何密钥
#
# 每周更新流程（免登录，全自动）：
#   1. 本地：npm run sync:data     # 复制 CSV 到 data/（含 brand_colors.json）
#   2. 本地：git add data/ && git commit && git push
#   3. GitHub Actions（周日 00:30 UTC 定时 + 手动可触发）：
#      ingest → prerender → commit 前端 JSON → Vercel 自动部署
#   需要 GitHub Secrets：SUPABASE_URL、SUPABASE_SERVICE_ROLE_KEY
