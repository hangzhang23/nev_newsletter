# Supabase（仅本地脚本使用；GitHub Actions 使用同名 Secrets，无需本地 .env）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # 仅 ingest / prerender 脚本
SUPABASE_ANON_KEY=                # 仅 /api 函数

# 数据源（本机周报工作区，含 CSV 与 brand_colors.json）
NEV_DATA_DIR=e:/workbuddy/space
NEV_GIT_BRANCH=main
# NEV_GIT_REMOTE=  # 可选；默认读取仓库 origin

# 无 VITE_ 前缀变量：前端纯静态，不注入任何密钥
#
# 每周更新流程（免登录，全自动）：
#   1. WorkBuddy 完成周报和 IMA 上传后调用 scripts/publish-workbuddy.cmd
#   2. 发布器校验数据并通过临时 clone 普通推送到 GitHub
#   3. GitHub Actions 自动执行 test → ingest → prerender → freshness check
#   4. GitHub Actions 回写静态 JSON，Vercel 自动部署
#   需要 GitHub Secrets：SUPABASE_URL、SUPABASE_SERVICE_ROLE_KEY
